# Copied to deploy/docker/.env by scripts/gen-env.sh.
# Values "__GENERATE__" are replaced with random secrets on first run.
# Existing values in .env are never overwritten. .env is NOT committed.

# Profiles: "simulator" runs the fake machine; "observability" adds cAdvisor.
COMPOSE_PROFILES=simulator,observability

# --- database --------------------------------------------------------------
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=__GENERATE__
GRAFANA_DB_PASSWORD=__GENERATE__

# --- MQTT --------------------------------------------------------------------
MQTT_USER=collector
MQTT_PASSWORD=__GENERATE__

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=__GENERATE__
GRAFANA_ANONYMOUS_VIEWER=false

# --- reverse proxy -----------------------------------------------------------
# Base URL users reach the platform at (provision.sh sets http://<vm-ip>).
PUBLIC_URL=http://localhost
HTTP_BIND=0.0.0.0
HTTP_PORT=80

# --- collector ---------------------------------------------------------------
COLLECTOR_ID=collector-01
# Comma-separated machine codes to poll (empty = all enabled machines).
COLLECTOR_MACHINES=
LOG_LEVEL=INFO

# --- simulator ---------------------------------------------------------------
SIM_SPEEDUP=1
SIM_SEED=

# --- RDC-53 (Phase 0: fill in after the on-site network survey) --------------
RDC53_PLC_IP=
RDC53_PLC_PORT=5007

# Docker data root on the host (cAdvisor mount). provision.sh sets /srv/docker.
DOCKER_DATA_ROOT=/var/lib/docker
