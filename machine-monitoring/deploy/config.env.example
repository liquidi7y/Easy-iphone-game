# Proxmox bootstrap configuration.
#
#   cp deploy/config.env.example deploy/config.env   # then edit
#   sudo ./deploy/bootstrap.sh
#
# bootstrap.sh uses these defaults if deploy/config.env does not exist.
# deploy/config.env is git-ignored; keep site-specific values there.

# --- VM identity -------------------------------------------------------------
# bootstrap never deletes or modifies a VM it did not create: if VMID is
# taken by a VM with a different name, or VM_NAME exists under another ID,
# it stops without changing anything.
VMID=9100
VM_NAME=machine-monitoring-01

# --- sizing (pilot) ----------------------------------------------------------
VM_CORES=4
VM_MEMORY_MB=8192
VM_OS_DISK_GB=32
VM_DATA_DISK_GB=100

# --- Proxmox resources -------------------------------------------------------
VM_STORAGE=local-lvm          # disk storage (must support "images")
SNIPPET_STORAGE=local         # directory storage for the cloud-init vendor snippet
VM_BRIDGE=vmbr0
VM_VLAN_TAG=                  # e.g. 30 once the OT VLAN exists (Phase 13)

# --- network -----------------------------------------------------------------
# "dhcp" or a static address in CIDR form. Static is recommended for a
# server the plant network will bookmark.
VM_IP=dhcp
VM_GATEWAY=                   # required with a static VM_IP
VM_DNS=                       # optional, e.g. 192.168.10.1
VM_SEARCHDOMAIN=

# --- access --------------------------------------------------------------------
VM_USER=nueva
# Public key(s) installed for VM_USER. Empty = generate
# /root/.ssh/machine-monitoring_ed25519 on the Proxmox host.
SSH_PUBLIC_KEY_FILE=
TIMEZONE=UTC

# --- OS image (Debian stable, generic cloud image) ---------------------------
IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2
IMAGE_SHA512_URL=https://cloud.debian.org/images/cloud/trixie/latest/SHA512SUMS
IMAGE_CACHE_DIR=/var/lib/vz/template/cache

# --- application -------------------------------------------------------------
APP_DIR=/opt/machine-monitoring
# Run the simulated machine (SIM01). Keep true until the RDC-53 is onboarded.
ENABLE_SIMULATOR=true
# Fill in after the Phase 0 network survey; RDC53 stays disabled in its YAML
# until the Mitsubishi read-only driver (M4) is in place.
RDC53_PLC_IP=

# --- preflight thresholds ----------------------------------------------------
MIN_FREE_MEMORY_MB=9216
