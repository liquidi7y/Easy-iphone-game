      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Produced today counts from 00:00 UTC."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Production per interval (all machines)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('$__interval', pc.time) AS time, m.code AS metric, sum(pc.delta) AS value\n  FROM production_counters pc JOIN machines m ON m.id = pc.machine_id\n  WHERE pc.counter = 'counter.total' AND $__timeFilter(pc.time) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Collector health (latest per machine)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (m.code) m.code AS machine, h.time, h.collector_id, h.plc_connected,\n       round(h.poll_duration_ms::numeric, 1) AS poll_ms, h.poll_errors_total AS poll_errors, h.details->>'error' AS last_error\n  FROM collector_health h JOIN machines m ON m.id = h.machine_id\n  WHERE h.time > now() - interval '1 hour' ORDER BY m.code, h.time DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
