{
  "uid": "machine-overview",
  "title": "All machines",
  "tags": [
    "machine-monitoring"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Machines",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT m.code AS machine, m.name,\n       CASE WHEN NOT m.enabled THEN 'OFF' WHEN cs.machine_id IS NULL OR now() - cs.updated_at > interval '15 seconds' THEN 'UNKNOWN' ELSE cs.state END AS state,\n       CASE WHEN NOT m.enabled THEN 'DISABLED' WHEN cs.machine_id IS NULL THEN 'NO DATA' WHEN now() - cs.updated_at > interval '15 seconds' THEN 'COLLECTOR DOWN'\n            WHEN cs.plc_connected THEN 'CONNECTED' ELSE 'PLC UNREACHABLE' END AS link,\n       extract(epoch FROM now() - cs.state_since) AS in_state,\n       (cs.normalized->'machine.speed'->>'value')::float AS speed,\n       (cs.normalized->'counter.total'->>'value')::bigint AS counter,\n       (SELECT coalesce(sum(delta), 0) FROM production_counters pc WHERE pc.machine_id = m.id\n          AND pc.counter = 'counter.total' AND pc.time >= date_trunc('day', now())) AS produced_today,\n       CASE WHEN m.simulated THEN 'simulated' WHEN NOT m.enabled THEN 'disabled' ELSE 'production' END AS source,\n       m.id AS id\n  FROM machines m LEFT JOIN machine_current_state cs ON cs.machine_id = m.id\n  ORDER BY m.enabled DESC, m.simulated, m.code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "RUNNING": {
                        "color": "green",
                        "index": 0,
                        "text": "RUNNING"
                      },
                      "IDLE": {
                        "color": "yellow",
                        "index": 1,
                        "text": "IDLE"
                      },
                      "READY": {
