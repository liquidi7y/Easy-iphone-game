                        "index": 7,
                        "text": "UNKNOWN"
                      },
                      "CONNECTED": {
                        "color": "green",
                        "index": 8,
                        "text": "CONNECTED"
                      },
                      "PLC UNREACHABLE": {
                        "color": "red",
                        "index": 9,
                        "text": "PLC UNREACHABLE"
                      },
                      "COLLECTOR DOWN": {
                        "color": "purple",
                        "index": 10,
                        "text": "COLLECTOR DOWN"
                      },
                      "NO DATA": {
                        "color": "purple",
                        "index": 11,
                        "text": "NO DATA"
                      },
                      "DISABLED": {
                        "color": "text",
                        "index": 12,
                        "text": "DISABLED"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "link"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "RUNNING": {
                        "color": "green",
                        "index": 0,
                        "text": "RUNNING"
                      },
                      "IDLE": {
