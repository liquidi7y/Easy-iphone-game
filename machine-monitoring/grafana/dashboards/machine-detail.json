    {
      "id": 7,
      "type": "stat",
      "title": "Produced (range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
