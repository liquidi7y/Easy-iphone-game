                    "type": "value",
                    "options": {
                      "good": {
                        "color": "green",
                        "index": 0
                      },
                      "uncertain": {
                        "color": "orange",
                        "index": 1
                      },
                      "stale": {
                        "color": "purple",
                        "index": 2
                      },
                      "bad": {
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Vendor-level device values as last read. UNVERIFIED addresses are not yet confirmed by device discovery."
