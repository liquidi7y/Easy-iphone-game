{
  "uid": "machine-detail",
  "title": "Machine detail",
  "tags": [
    "machine-monitoring"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "machine",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT id AS __value, code || CASE WHEN simulated THEN ' (simulated)' ELSE '' END AS __text FROM machines ORDER BY enabled DESC, simulated, code",
        "definition": "machines",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 0,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Machine state",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN now() - updated_at > interval '15 seconds' THEN 'UNKNOWN' ELSE state END AS state FROM machine_current_state WHERE machine_id = $machine"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "RUNNING": {
                  "color": "green",
                  "index": 0,
                  "text": "RUNNING"
                },
                "IDLE": {
                  "color": "yellow",
                  "index": 1,
                  "text": "IDLE"
                },
                "READY": {
                  "color": "blue",
                  "index": 2,
                  "text": "READY"
                },
                "STOPPED": {
                  "color": "orange",
                  "index": 3,
                  "text": "STOPPED"
                },
                "FAULT": {
                  "color": "red",
                  "index": 4,
                  "text": "FAULT"
                },
                "E_STOP": {
                  "color": "dark-red",
                  "index": 5,
                  "text": "E-STOP"
                },
                "OFF": {
                  "color": "text",
                  "index": 6,
                  "text": "OFF"
                },
                "UNKNOWN": {
                  "color": "purple",
                  "index": 7,
                  "text": "UNKNOWN"
                },
                "CONNECTED": {
                  "color": "green",
                  "index": 8,
                  "text": "CONNECTED"
                },
                "PLC UNREACHABLE": {
                  "color": "red",
                  "index": 9,
                  "text": "PLC UNREACHABLE"
                },
                "COLLECTOR DOWN": {
                  "color": "purple",
                  "index": 10,
                  "text": "COLLECTOR DOWN"
                },
                "NO DATA": {
                  "color": "purple",
                  "index": 11,
                  "text": "NO DATA"
                },
                "DISABLED": {
                  "color": "text",
                  "index": 12,
                  "text": "DISABLED"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "wideLayout": true
      },
      "description": "Canonical state. UNKNOWN means the monitoring path cannot see the machine - it is never shown as STOPPED."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "In state for",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM now() - state_since) AS seconds FROM machine_current_state WHERE machine_id = $machine AND now() - updated_at <= interval '15 seconds'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
