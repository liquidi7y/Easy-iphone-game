          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT time, event_type AS event, data::text AS details FROM machine_events\n  WHERE machine_id = $machine AND $__timeFilter(time) ORDER BY time DESC LIMIT 100"
