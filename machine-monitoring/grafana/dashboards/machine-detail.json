    {
      "id": 15,
      "type": "table",
      "title": "Raw signals (diagnostic)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT key AS signal, value->>'address' AS address, value->>'value' AS value,\n       CASE WHEN now() - cs.updated_at > interval '15 seconds' THEN 'stale' ELSE value->>'quality' END AS quality,\n       CASE WHEN (value->>'verified')::boolean THEN 'verified' ELSE 'UNVERIFIED' END AS mapping\n  FROM machine_current_state cs, jsonb_each(cs.signals) WHERE cs.machine_id = $machine ORDER BY 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "quality"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
