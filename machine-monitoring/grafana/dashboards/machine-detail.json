          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(delta), 0) AS produced FROM production_counters\n              WHERE machine_id = $machine AND counter = 'counter.total' AND $__timeFilter(time)"
