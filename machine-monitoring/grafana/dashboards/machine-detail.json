          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, value AS \"speed\" FROM normalized_samples\n  WHERE machine_id = $machine AND name = 'machine.speed' AND $__timeFilter(time) ORDER BY time"
