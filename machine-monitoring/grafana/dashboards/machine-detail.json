    {
      "id": 10,
      "type": "timeseries",
      "title": "Production per interval",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('$__interval', time) AS time, sum(delta) AS \"sheets\"\n  FROM production_counters WHERE machine_id = $machine AND counter = 'counter.total' AND $__timeFilter(time)\n  GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Active order",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT o.order_number AS \"order\", o.product, o.target_quantity AS target,\n       (SELECT value FROM production_counters pc WHERE pc.machine_id = s.machine_id AND counter = 'counter.total'\n         ORDER BY time DESC LIMIT 1) - s.start_counter AS produced,\n       s.operator, s.shift, s.started_at AS started\n  FROM machine_order_sessions s JOIN orders o ON o.id = s.order_id\n  WHERE s.machine_id = $machine AND s.ended_at IS NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Time in state (range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH changes AS (\n  (SELECT time, new_state FROM machine_state_events WHERE machine_id = $machine AND time < $__timeFrom() ORDER BY time DESC LIMIT 1)\n  UNION ALL SELECT time, new_state FROM machine_state_events WHERE machine_id = $machine AND $__timeFilter(time)\n), spans AS (\n  SELECT new_state, greatest(time, $__timeFrom()) AS s, least(coalesce(lead(time) OVER (ORDER BY time), now()), $__timeTo()) AS e FROM changes\n)\nSELECT new_state AS state, sum(extract(epoch FROM e - s)) AS seconds FROM spans WHERE e > s GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Downtime",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS started, ended_at AS ended, state, reason,\n       extract(epoch FROM coalesce(ended_at, now()) - started_at) AS duration\n  FROM downtime_events WHERE machine_id = $machine\n   AND started_at < $__timeTo() AND (ended_at IS NULL OR ended_at > $__timeFrom())\n  ORDER BY started_at DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
