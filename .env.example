# ===========================================
# POLYMARKET SENTINEL - CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values

# ----- POLYMARKET / CLOB API -----
# Your Polymarket API credentials
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_API_PASSPHRASE=your_passphrase_here

# Your wallet private key (for signing transactions)
# CRITICAL: Keep this secure, never share or commit!
WALLET_PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# ----- TWITTER/X API -----
# Get from: https://developer.twitter.com/
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_token_secret

# ----- BLOCKCHAIN RPC -----
# Polygon RPC for whale tracking (Alchemy or Infura recommended)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_key
# Backup RPC
POLYGON_RPC_BACKUP=https://polygon-rpc.com

# ----- RISK MANAGEMENT -----
# Maximum capital to risk (in USDC)
MAX_CAPITAL_USDC=1000
# Maximum single bet as % of capital (0.01 = 1%)
MAX_BET_PERCENT=0.03
# Maximum total exposure as % of capital
MAX_EXPOSURE_PERCENT=0.25
# Stop loss - pause trading if drawdown exceeds this %
MAX_DRAWDOWN_PERCENT=0.15
# Minimum edge required to place bet (Kelly fraction)
MIN_EDGE_THRESHOLD=0.05

# ----- BOT SETTINGS -----
# Polling interval in seconds
POLL_INTERVAL_SECONDS=60
# Require manual approval for bets above this USDC amount (0 = auto all)
MANUAL_APPROVAL_THRESHOLD=50
# Dry run mode (true = no real trades)
DRY_RUN=true
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ----- NOTIFICATIONS (Optional) -----
# Telegram bot for alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord webhook
DISCORD_WEBHOOK_URL=
